+fn wine_supports_ntsync(wine: &std::path::Path) -> bool {
+    let Ok(output) = Command::new(wine).arg("--version").output() else {
+        return false;
+    };
+
+    let version = String::from_utf8_lossy(&output.stdout);
+    version
+        .split(|c: char| !c.is_ascii_digit())
+        .find(|part| !part.is_empty())
+        .and_then(|major| major.parse::<u32>().ok())
+        .is_some_and(|major| major >= 11)
+}
+
+fn ntsync_available(wine: &std::path::Path) -> bool {
+    wine_supports_ntsync(wine) && File::open("/dev/ntsync").is_ok()
+}
+
+fn executable_on_path(name: &str, path: Option<&OsStr>, cwd: &Path) -> bool {
+    let path = path.unwrap_or_else(|| OsStr::new("/usr/local/bin:/usr/bin:/bin"));
+    std::env::split_paths(path).any(|dir| {
+        cwd.join(dir).join(name).metadata().is_ok_and(|metadata| {
+            metadata.is_file() && metadata.permissions().mode() & 0o111 != 0
+        })
+    })
+}
+
+/// Check for the optional host package without starting the compositor.
+pub fn is_gamescope_available() -> bool {
+    executable_on_path("gamescope", std::env::var_os("PATH").as_deref(), Path::new("."))
+}
+
+fn gamescope_command(
+    settings: &Gamescope,
+    env: impl Fn(&str) -> Option<OsString>,
+    game_dir: &Path,
+) -> Option<String> {
+    if !settings.enabled {
+        return None;
+    }
+
+    let path = env("PATH");
+    if !executable_on_path("gamescope", path.as_deref(), game_dir) {
+        tracing::warn!("Gamescope is missing; launching directly");
+        return None;
+    }
+    if !["DISPLAY", "WAYLAND_DISPLAY"].iter().any(|key| {
+        env(key).is_some_and(|value| !value.is_empty())
+    }) {
+        tracing::warn!("Gamescope needs a desktop display; launching directly");
+        return None;
+    }
+
+    let mut settings = settings.clone();
+    if settings.options.mangohud && !executable_on_path("mangoapp", path.as_deref(), game_dir) {
+        tracing::warn!("mangoapp is missing; starting Gamescope without the overlay");
+        settings.options.mangohud = false;
+    }
+
+    settings.get_command()
+}
+
