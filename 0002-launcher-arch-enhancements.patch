+        crate::i18n::LANG.get_or_init(|| crate::i18n::get_default_lang().clone());
+        let size = GamescopeWindowSize { width: Some(1920), height: Some(1080) };
+        let (picker, custom) = resolution_rows(
+            "Output resolution",
+            "Gamescope default",
+            "Custom output resolution",
+            size,
+            |_, _| {},
+        );
+        let model = picker.model().unwrap();
+        let item = model.item(picker.selected()).unwrap();
+        let label = picker.expression().unwrap().evaluate_as::<String, _>(Some(&item));
+        assert_eq!(label.as_deref(), Some("1920x1080"));
+        assert!(picker.property::<bool>("enable-search"));
+        assert_eq!(model.n_items(), CUSTOM_RESOLUTION + 1);
+        assert!(!custom.property::<bool>("visible"));
+        picker.set_selected(CUSTOM_RESOLUTION);
+        assert!(custom.property::<bool>("visible"));
+        assert_eq!(custom.text().as_str(), "1920x1080");
+        picker.set_selected(0);
+        assert!(!custom.property::<bool>("visible"));
+    }
+
+    #[test]
+    fn integer_filter_uses_nearest_and_preserves_the_saved_scaling_mode() {
+        let mut scaling = GamescopeUpscaling {
+            upscaler: GamescopeUpscaler::Fill,
+            filter: GamescopeUpscaleFilter::Integer,
+            sharpness_value: Some(7),
+            ..Default::default()
+        };
+        assert_eq!(scaling.get_command(), "--scaler integer --filter nearest");
+        scaling.filter = GamescopeUpscaleFilter::FSR;
+        assert_eq!(scaling.get_command(), "--scaler fill --filter fsr --sharpness 7");
+    }
+
+    #[test]
+    fn sharpness_accepts_legacy_presets_and_valid_numeric_levels() {
+        let old = serde_json::json!({"filter": "NIS", "sharpness": "High"});
+        let mut scaling = GamescopeUpscaling::from(&old);
+        assert_eq!(scaling.sharpness_level(), 5);
+        assert_eq!(scaling.get_command(), "--filter nis --sharpness 5");
+        scaling.sharpness_value = Some(0);
+        let saved = serde_json::to_value(scaling).unwrap();
+        assert_eq!(GamescopeUpscaling::from(&saved), scaling);
+
+        let invalid = serde_json::json!({"filter": "NIS", "sharpness": "High", "sharpness_value": 21});
+        assert_eq!(GamescopeUpscaling::from(&invalid).sharpness_level(), 5);
+    }
+}
