+fn update_optional_preferences(gamemode: bool, system76_scheduler: bool) {
+    if let Ok(mut config) = Config::get() {
+        config.game.enhancements.gamemode = gamemode;
+        config.game.enhancements.system76_scheduler = system76_scheduler;
+        Config::update(config);
+    }
+}
+
+fn show_optional_install_dialog(
+    title: &str,
+    description: &str,
+    install_message: EnhancementsAppMsg,
+    sender: relm4::Sender<EnhancementsAppMsg>,
+) {
+    let parent = relm4::main_application().active_window();
+    let dialog = adw::MessageDialog::new(
+        parent.as_ref(),
+        Some(title),
+        Some(description),
+    );
+    dialog.add_responses(&[
+        ("cancel", &tr!("optional-dependency-cancel-button")),
+        ("install", &tr!("optional-dependency-install-button")),
+    ]);
+    dialog.set_default_response(Some("install"));
+    dialog.set_close_response("cancel");
+    dialog.set_response_appearance("install", adw::ResponseAppearance::Suggested);
+    dialog.connect_response(Some("install"), move |_, _| {
+        let _ = sender.send(install_message.clone());
+    });
+    dialog.present();
+}
+
+fn run_optional_dependency_helper(feature: &str) -> bool {
+    std::process::Command::new("pkexec")
+        .arg("/usr/lib/honkers-railway-launcher/install-optional-dependency")
+        .arg(feature)
+        .status()
+        .map(|status| status.success())
+        .unwrap_or(false)
+}
+
+fn is_system76_scheduler_responsive() -> bool {
+    std::process::Command::new("busctl")
+        .args([
+            "--timeout=2s",
+            "introspect",
+            "--system",
+            "com.system76.Scheduler",
+            "/com/system76/Scheduler",
+        ])
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .map(|status| status.success())
+        .unwrap_or(false)
+}
+
+fn is_system76_scheduler_pipewire_monitor_enabled() -> bool {
+    [
+        "/etc/system76-scheduler/config.kdl",
+        "/usr/share/system76-scheduler/config.kdl",
+    ]
+    .iter()
+    .find_map(|path| std::fs::read_to_string(path).ok())
+    .map(|config| {
+        config.lines().any(|line| {
+            let setting = line.split("//").next().unwrap_or("").trim();
+            setting.starts_with("pipewire ") && setting.contains("nice=")
+        })
+    })
+    .unwrap_or(false)
+}
