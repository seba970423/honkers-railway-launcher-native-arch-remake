+        for text in ["", "x", "1280", "0x1080", "1920xabc", "16385x1080", "1x2x3"] {
+            assert_eq!(parse_custom_resolution(text), None, "{text}");
+        }
+        assert_eq!(
+            parse_custom_resolution(" 1600 × 900 "),
+            Some(GamescopeWindowSize { width: Some(1600), height: Some(900) }),
+        );
+    }
