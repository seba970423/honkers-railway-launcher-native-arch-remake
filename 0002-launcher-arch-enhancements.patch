+fn save_gamescope(update: impl FnOnce(&mut Gamescope)) {
+    if is_ready() {
+        if let Ok(mut config) = Config::get() {
+            update(&mut config.game.enhancements.gamescope);
+            Config::update(config);
+        }
+    }
+}
+
+const RESOLUTION_PRESETS: &[(u64, u64)] = &[
+    (640, 480), (800, 600), (1024, 768), (1280, 720), (1280, 800), (1280, 1024),
+    (1366, 768), (1440, 900), (1600, 900), (1680, 1050), (1920, 1080), (1920, 1200),
+    (2560, 1080), (2560, 1440), (2560, 1600), (3440, 1440), (3840, 2160),
+    (5120, 1440), (7680, 4320),
+];
+const CUSTOM_RESOLUTION: u32 = RESOLUTION_PRESETS.len() as u32 + 1;
+
+fn resolution_selection(size: GamescopeWindowSize) -> u32 {
+    match (size.width, size.height) {
+        (None, None) => 0,
+        (Some(width), Some(height)) => RESOLUTION_PRESETS
+            .iter()
+            .position(|&preset| preset == (width, height))
+            .map_or(CUSTOM_RESOLUTION, |index| index as u32 + 1),
+        _ => CUSTOM_RESOLUTION,
+    }
+}
+
+fn resolution_text(size: GamescopeWindowSize) -> String {
+    if size.width.is_none() && size.height.is_none() {
+        return String::new();
+    }
+
+    let width = size.width.map(|value| value.to_string()).unwrap_or_default();
+    let height = size.height.map(|value| value.to_string()).unwrap_or_default();
+    format!("{width}x{height}")
+}
+
+fn parse_custom_resolution(text: &str) -> Option<GamescopeWindowSize> {
+    fn dimension(text: &str) -> Option<Option<u64>> {
+        let text = text.trim();
+        if text.is_empty() {
+            return Some(None);
+        }
+
+        let value = text.parse::<u64>().ok().filter(|value| (1..=16384).contains(value))?;
+        Some(Some(value))
+    }
+
+    let (width, height) = text.split_once(['x', 'X', '×'])?;
+    let width = dimension(width)?;
+    let height = dimension(height)?;
+    (width.is_some() || height.is_some()).then_some(GamescopeWindowSize { width, height })
+}
+
+fn resolution_rows(
+    title: &str,
+    default_label: &str,
+    custom_label: &str,
+    initial: GamescopeWindowSize,
+    save: impl Fn(&mut Gamescope, GamescopeWindowSize) + Copy + 'static,
+) -> (adw::ComboRow, adw::EntryRow) {
+    let choices = gtk::StringList::new(&[default_label]);
+    for (width, height) in RESOLUTION_PRESETS {
+        choices.append(&format!("{width}x{height}"));
+    }
+    choices.append(&tr!("gamescope-custom-resolution"));
+
+    let selected = resolution_selection(initial);
+    let combo = adw::ComboRow::new();
+    combo.set_title(title);
+    combo.set_model(Some(&choices));
+    let label = gtk::PropertyExpression::new(
+        gtk::StringObject::static_type(),
+        gtk::Expression::NONE,
+        "string",
+    );
+    combo.set_expression(Some(label));
+    combo.set_enable_search(true);
+    combo.set_selected(selected);
+
+    let custom = adw::EntryRow::new();
+    custom.set_title(custom_label);
+    custom.set_tooltip_text(Some(&tr!("gamescope-custom-resolution-format")));
+    custom.set_text(&resolution_text(initial));
+    custom.set_show_apply_button(true);
+    custom.set_visible(selected == CUSTOM_RESOLUTION);
+
+    let entry = custom.clone();
+    combo.connect_selected_notify(move |row| {
+        let selected = row.selected();
+        entry.set_visible(selected == CUSTOM_RESOLUTION);
+        let size = match selected {
+            0 => Some(GamescopeWindowSize::default()),
+            CUSTOM_RESOLUTION => parse_custom_resolution(&entry.text()),
+            index => RESOLUTION_PRESETS.get((index - 1) as usize)
+                .map(|&(width, height)| GamescopeWindowSize {
+                    width: Some(width),
+                    height: Some(height),
+                }),
+        };
+        if let Some(size) = size {
+            save_gamescope(|settings| save(settings, size));
+        }
+    });
+
+    let label = custom_label.to_string();
+    custom.connect_changed(move |row| {
+        row.remove_css_class("error");
+        row.set_title(&label);
+    });
+    custom.connect_apply(move |row| {
+        if let Some(size) = parse_custom_resolution(&row.text()) {
+            save_gamescope(|settings| save(settings, size));
+        } else {
+            row.add_css_class("error");
+            row.set_title(&tr!("gamescope-invalid-resolution"));
+        }
+    });
+
+    (combo, custom)
+}
+
+fn enum_row<T: PartialEq>(title: &str, choices: &[(T, String)], initial: T) -> adw::ComboRow {
+    let labels: Vec<_> = choices.iter().map(|(_, label)| label.as_str()).collect();
+    let selected = choices.iter().position(|(value, _)| *value == initial).unwrap_or(0);
+    let row = adw::ComboRow::new();
+    row.set_title(title);
+    row.set_model(Some(&gtk::StringList::new(&labels)));
+    row.set_selected(selected as u32);
+    row
+}
+
+fn scaling_rows(initial: GamescopeUpscaling) -> (adw::ComboRow, adw::ComboRow, adw::SpinRow) {
+    use GamescopeUpscaleFilter as Filter;
+    use GamescopeUpscaler as Mode;
+
+    let filters = [
+        (Filter::Linear, tr!("linear")),
+        (Filter::FSR, tr!("gamescope-fsr-filter")),
+        (Filter::NIS, tr!("nis")),
+        (Filter::Integer, tr!("integer")),
+        (Filter::Nearest, tr!("gamescope-nearest-filter")),
+        (Filter::Pixel, tr!("pixel")),
+    ];
+    let mut modes = vec![
+        (Mode::Fit, tr!("gamescope-fit")),
+        (Mode::Fill, tr!("gamescope-fill")),
+        (Mode::Stretch, tr!("stretch")),
+        (Mode::Auto, tr!("auto")),
+    ];
+    if initial.upscaler == Mode::Integer {
+        modes.push((Mode::Integer, tr!("integer")));
+    }
+
+    let filter = enum_row(&tr!("upscale-filter"), &filters, initial.filter);
+    let mode = enum_row(&tr!("gamescope-scaling-mode"), &modes, initial.upscaler);
+    mode.set_subtitle(&tr!("gamescope-scaling-description"));
+    mode.set_sensitive(initial.filter != Filter::Integer);
+
+    let sharpness = adw::SpinRow::with_range(0.0, 20.0, 1.0);
+    sharpness.set_title(&tr!("gamescope-sharpness"));
+    sharpness.set_subtitle(&tr!("gamescope-sharpness-range"));
+    sharpness.set_numeric(true);
+    sharpness.set_value(f64::from(initial.sharpness_level()));
+    sharpness.set_sensitive(initial.filter.supports_sharpness());
+
+    let mode_row = mode.clone();
+    let sharpness_row = sharpness.clone();
+    filter.connect_selected_notify(move |row| {
+        if let Some((filter, _)) = filters.get(row.selected() as usize) {
+            mode_row.set_sensitive(*filter != Filter::Integer);
+            sharpness_row.set_sensitive(filter.supports_sharpness());
+            save_gamescope(|settings| settings.upscaling.filter = *filter);
+        }
+    });
+    mode.connect_selected_notify(move |row| {
+        if let Some((mode, _)) = modes.get(row.selected() as usize) {
+            save_gamescope(|settings| settings.upscaling.upscaler = *mode);
+        }
+    });
+    sharpness.connect_value_notify(|row| {
+        save_gamescope(|settings| settings.upscaling.sharpness_value = Some(row.value() as u8));
+    });
+
+    (filter, mode, sharpness)
+}
+
+fn fps_row(
+    title: &str,
+    initial: Option<u64>,
+    save: impl Fn(&mut Gamescope, Option<u64>) + 'static,
+) -> adw::SpinRow {
+    let value = initial.unwrap_or(0);
+    let row = adw::SpinRow::with_range(0.0, value.max(1000) as f64, 1.0);
+    row.set_title(title);
+    row.set_subtitle(&tr!("gamescope-fps-unlimited"));
+    row.set_numeric(true);
+    row.set_value(value as f64);
+    row.connect_value_notify(move |row| {
+        let value = row.value() as u64;
+        save_gamescope(|settings| save(settings, (value > 0).then_some(value)));
+    });
+    row
+}
