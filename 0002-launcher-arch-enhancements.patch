+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn saved_resolutions_select_the_default_preset_or_custom() {
+        assert_eq!(resolution_selection(GamescopeWindowSize::default()), 0);
+        for (index, &(width, height)) in RESOLUTION_PRESETS.iter().enumerate() {
+            let size = GamescopeWindowSize { width: Some(width), height: Some(height) };
+            assert_eq!(resolution_selection(size), index as u32 + 1);
+        }
+        for text in ["1234x900", "x1080", "1920x"] {
+            let size = parse_custom_resolution(text).unwrap();
+            assert_eq!(resolution_selection(size), CUSTOM_RESOLUTION);
+            assert_eq!(resolution_text(size), text);
+        }
+    }
+
+    #[test]
